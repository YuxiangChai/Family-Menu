# 仅服务端使用，复制为 server/.env 后填写。不要把真实 .env 提交到 Git。
WX_APP_ID=your-mini-program-appid
WX_APP_SECRET=your-mini-program-appsecret

# 本机测试；接入 Tunnel 后改为 https://menu.你的域名
PUBLIC_BASE_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000

# 留空使用 server/data。Docker 容器内使用 /app/server/data。
# MENU_DATA_DIR=/absolute/path/to/family-menu-data

# 当前采用用户主动分享订单图片，不需要订阅消息模板配置。
