<custom-nav title="订单详情" />
<view class="page {{actions.length ? 'page-with-cta' : ''}}">
  <view wx:if="{{loading}}" class="state-panel card"><view class="state-mark">···</view><view class="state-title">正在整理订单</view></view>
  <view wx:elif="{{error}}" class="state-panel card"><view class="state-mark">!</view><view class="state-title">订单没加载出来</view><view class="state-text">{{error}}</view><button class="secondary-button" bindtap="loadOrder">重试</button></view>
  <block wx:else>
    <view class="order-hero card"><view><text class="eyebrow">{{order.orderDate}}</text><view class="serif-title hero-title">{{order.creatorName}} 的点菜</view><view class="muted">{{order.timeText}} · {{order.dinerCount}} 人</view></view><text class="status-chip {{order.statusClass}}">{{order.statusText}}</text></view>
    <view class="section card"><view class="serif-title section-title">今晚菜单</view><view wx:for="{{order.items}}" wx:key="dishId" class="dish-row"><view><view class="dish-name">{{item.name}}</view></view><text class="servings">{{item.servings}} 份</text></view><view wx:if="{{order.remark}}" class="remark"><text class="remark-label">家人口味备注</text><view>{{order.remark}}</view></view></view>
    <view class="section card"><view class="section-heading"><view class="serif-title section-title">食材清单</view><text class="muted total">{{order.ingredientSummary.length}} 项</text></view><view wx:for="{{order.ingredientSummary}}" wx:key="index" class="ingredient-row"><view class="ingredient-main"><view><text class="ingredient-name">{{item.name}}</text><text wx:if="{{item.note}}" class="muted note"> · {{item.note}}</text></view><view class="sources">来自：{{item.sourcesText}}</view></view><text class="amount">{{item.quantity}}{{item.unit}}</text></view></view>
  </block>
</view>
<view wx:if="{{actions.length}}" class="bottom-cta action-bar"><button wx:for="{{actions}}" wx:key="status" class="{{item.primary ? 'primary-button' : 'danger-button'}}" data-status="{{item.status}}" bindtap="changeStatus" disabled="{{updating}}">{{item.label}}</button></view>
