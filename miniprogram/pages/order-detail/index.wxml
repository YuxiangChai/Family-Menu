<transition-page route="pages/order-detail/index">
<view class="page order-detail-page">
  <view wx:if="{{loading}}" class="state-panel card"><view class="state-mark">···</view><view class="state-title">正在整理订单</view></view>
  <view wx:elif="{{error && !order}}" class="state-panel card"><view class="state-title">订单没加载出来</view><view class="state-text">{{error}}</view><button class="secondary-button" bindtap="loadOrder">重试</button></view>
  <block wx:elif="{{order}}">
    <view class="order-hero card"><view><text class="hero-date">{{order.dateText}}<text wx:if="{{order.weekdayText}}"> · {{order.weekdayText}}</text></text><view class="serif-title hero-title">{{order.creatorName}} 的点菜</view><view class="muted">{{order.timeText}} · {{order.dinerCount}} 人用餐</view><view wx:if="{{order.updatedAt && order.updatedAt !== order.createdAt}}" class="muted">最近修改 {{order.updatedText}}</view></view></view>
    <view class="section card share-section">
      <view class="serif-title section-title">把菜单发给家人</view>
      <view class="poster-frame" style="padding-top: {{posterAspect}}%;">
        <image wx:if="{{posterPath}}" src="{{posterPath}}" mode="aspectFit" class="poster-preview" bindtap="previewImage" aria-label="预览订单分享图片" />
        <view wx:elif="{{generating}}" class="poster-state">正在生成菜单图片…</view>
      </view>
      <view wx:if="{{posterError}}" class="poster-error"><view>{{posterError}}</view><button class="secondary-button poster-retry" bindtap="generateImage" loading="{{generating}}" disabled="{{generating}}">重试生成</button></view>
      <view class="share-action"><button class="primary-button share-button" hover-class="button-pressed" bindtap="shareImage" loading="{{sharing}}" disabled="{{!posterPath || !posterCurrent || generating || sharing || refreshing || error}}">分享图片到微信</button></view>
      <view class="order-tools"><button wx:if="{{canEdit}}" class="secondary-button" hover-class="button-pressed" bindtap="editOrder" loading="{{editing}}" disabled="{{editing || refreshing || error}}">修改订单</button><button class="secondary-button" hover-class="button-pressed" bindtap="copyOrder" loading="{{copying}}" disabled="{{copying}}">再点一次</button></view>
    </view>
    <view wx:if="{{order.ingredientSummary.length}}" class="section card"><view class="section-heading"><view class="serif-title section-title">食材清单</view><text class="muted total">{{order.ingredientSummary.length}} 项</text></view><view wx:for="{{order.ingredientSummary}}" wx:key="index" class="ingredient-row"><view class="ingredient-main"><view><text class="ingredient-name">{{item.name}}</text><text wx:if="{{item.note}}" class="muted note"> · {{item.note}}</text></view><view class="sources">来自：{{item.sourcesText}}</view></view><text class="amount">{{item.quantity}}{{item.unit}}</text></view></view>
  </block>
  <view wx:if="{{error && order}}" class="poster-error">{{error}}<button class="secondary-button poster-retry" bindtap="loadOrder">重试更新</button></view>
</view>
</transition-page>
<canvas type="2d" id="order-poster" class="poster-canvas" />
