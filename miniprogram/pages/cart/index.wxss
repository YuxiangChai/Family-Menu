.cart-page { padding-bottom: calc(34rpx + env(safe-area-inset-bottom)); }
.page-heading { margin: 4rpx 6rpx 20rpx 18rpx; }
.title { margin: 3rpx 0 5rpx; font-size: 44rpx; }
.page-heading .muted { font-size: 24rpx; }
.cart-list { display: grid; gap: 10rpx; }
.cart-item { min-height: 112rpx; padding: 12rpx; display: grid; grid-template-columns: 84rpx minmax(0, 1fr) 96rpx; align-items: center; gap: 8rpx; }
.thumb { width: 84rpx; height: 84rpx; flex: none; border-radius: 12rpx; }
.placeholder-thumb { background: linear-gradient(145deg, #d9aa8e, #efd8c4); color: var(--brand-dark); display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 800; }
.item-name { min-width: 0; padding-left: 6rpx; font-size: 26rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cart-item .remove { width: 96rpx; min-height: 88rpx; margin: 0; padding: 0; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; background: var(--brand-soft); color: var(--danger); font-size: 24rpx; font-weight: 500; line-height: 1; }
.add-more { width: 100%; min-height: 66rpx; margin: 10rpx 0 12rpx; padding: 0 16rpx; border: 1rpx solid var(--line); border-radius: 16rpx; display: flex; align-items: center; color: var(--brand-dark); background: rgba(255,252,247,.7); font-size: 22rpx; font-weight: 700; }
.add-more-icon { width: 38rpx; height: 38rpx; border-radius: 19rpx; display: flex; align-items: center; justify-content: center; background: var(--brand-soft); color: var(--brand); font-size: 25rpx; }
.add-more-label { margin-left: 12rpx; }
.add-more-arrow { margin-left: auto; color: var(--muted); font-size: 32rpx; font-weight: 400; }
.form-card { padding: 20rpx 22rpx 22rpx; }
.diner-label { margin-top: 0; }
.form-error { margin-top: 18rpx; padding: 16rpx; border-radius: 12rpx; background: #fae5df; color: var(--danger); font-size: 24rpx; }
.submit-order { width: 100%; margin-top: 16rpx; }
.submit-order.is-disabled { opacity: .45; box-shadow: none; }
.edit-notice { padding: 22rpx; margin-bottom: 20rpx; color: var(--brand-dark); }
.edit-links { display: flex; gap: 16rpx; margin-top: 16rpx; }
.edit-links .secondary-button { flex: 1; min-width: 0; font-size: 24rpx; }
