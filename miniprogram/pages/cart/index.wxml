<transition-page route="pages/cart/index">
<view class="page cart-page">
  <view class="page-heading"><text class="eyebrow">全家共享一份菜单</text><view class="serif-title title">{{editOrderId ? '修改这份订单' : '当前菜单'}}</view><view class="muted">每道菜只选一次，做多少由家里决定。</view></view>
  <view wx:if="{{loading}}" class="state-panel card">正在同步全家菜单…</view>
  <view wx:if="{{menuId}}" class="edit-notice card"><view>{{editOrderId ? '正在修改订单' : '全家正在一起点菜'}}</view><view class="edit-links"><button wx:if="{{isAdmin}}" class="secondary-button" bindtap="cancelEdit" disabled="{{submitting || changing}}">结束当前菜单</button><button class="secondary-button" bindtap="reloadEdit" disabled="{{submitting || changing}}">刷新菜单</button></view></view>
  <view wx:if="{{error}}" class="form-error">{{error}}</view>
  <view wx:if="{{!loading && !items.length}}" class="state-panel card"><view class="state-mark">＋</view><view class="state-title">当前菜单还是空的</view><view class="state-text">回首页选择，家人会看到同一份菜单。</view><button class="secondary-button" bindtap="addMore">去选菜</button></view>
  <block wx:if="{{!loading && menuId}}">
    <view class="cart-list">
      <view wx:for="{{items}}" wx:key="dishId" class="cart-item card">
        <image wx:if="{{item.imageFileId}}" src="{{item.imageFileId}}" mode="aspectFill" class="thumb" />
        <view wx:else class="thumb placeholder-thumb">{{item.name[0]}}</view>
        <view class="item-name serif-title">{{item.name}}</view>
        <button class="remove" data-id="{{item.dishId}}" bindtap="removeItem" disabled="{{submitting || changing}}" aria-label="移除{{item.name}}">移除</button>
      </view>
    </view>
    <view class="add-more" bindtap="addMore" hover-class="button-pressed" role="button" tabindex="0"><text class="add-more-icon">＋</text><text class="add-more-label">再加一道菜</text><text class="add-more-arrow">›</text></view>
    <view class="form-card card">
      <label class="field-label diner-label" for="dinerCount">就餐人数</label>
      <input id="dinerCount" class="field-input" type="number" value="{{dinerCount}}" bindinput="onDinerCount" disabled="{{submitting || changing}}" placeholder="1–20 人" />
      <label class="field-label" for="remark">口味备注</label>
      <textarea id="remark" class="field-textarea" value="{{remark}}" bindinput="onRemark" disabled="{{submitting || changing}}" maxlength="300" placeholder="例如：少辣、不要香菜" placeholder-class="placeholder" />
    </view>
    <button class="primary-button submit-order" bindtap="submitOrder" loading="{{submitting}}" disabled="{{submitting || changing || (!items.length && !editOrderId)}}">{{editOrderId ? '保存修改并生成图片' : '下单并生成图片'}}</button>
  </block>
</view>
</transition-page>
