.invite-page { padding-top: 28rpx; padding-bottom: 96rpx; }
.heading { margin: 4rpx 6rpx 28rpx 18rpx; }
.heading-title { margin: 5rpx 0 5rpx; font-size: 44rpx; font-weight: 800; line-height: 1.35; }
.heading .muted { font-size: 22rpx; }
.status-card { padding: 24rpx; }
.status-top { display: flex; align-items: center; gap: 18rpx; }
.status-icon { width: 62rpx; height: 62rpx; flex: none; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; background: #e2ecdf; color: var(--leaf); font-size: 28rpx; font-weight: 800; }
.status-title { font-size: 28rpx; font-weight: 800; }
.status-copy { margin-top: 2rpx; color: var(--muted); font-size: 20rpx; }
.code-card { margin-top: 14rpx; padding: 30rpx 24rpx 24rpx; text-align: center; border-color: rgba(185,71,50,.18); }
.code-label { color: var(--brand-dark); font-size: 20rpx; font-weight: 700; }
.code-value { margin: 16rpx 0 20rpx; color: var(--ink); font-size: 38rpx; font-weight: 800; letter-spacing: 3rpx; }
.copy-code { width: 100%; }
.code-tip { margin: 18rpx 8rpx 0; color: var(--muted); font-size: 18rpx; line-height: 1.65; }
.action-card { margin-top: 14rpx; padding: 28rpx 24rpx; }
.action-title { font-size: 30rpx; font-weight: 800; }
.action-desc { margin-top: 4rpx; color: var(--muted); font-size: 21rpx; }
.random-button { width: 100%; min-height: 88rpx; margin-top: 22rpx; border: 1rpx solid #d6e3d2; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; background: #edf3e9; color: #355a3f; font-size: 27rpx; font-weight: 800; }
.random-mark { color: var(--leaf); font-size: 30rpx; }
.or-divider { margin: 30rpx 0 8rpx; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 14rpx; color: #9b9186; font-size: 19rpx; }
.or-divider text { height: 1rpx; background: var(--line); }
.custom-input { letter-spacing: 1rpx; }
.input-help { margin-top: 9rpx; color: var(--muted); font-size: 19rpx; }
.save-custom { width: 100%; margin-top: 22rpx; }
.security-line { margin: 25rpx 8rpx 0; display: flex; align-items: flex-start; justify-content: center; gap: 8rpx; color: var(--muted); font-size: 19rpx; text-align: center; }
.security-line text { color: var(--leaf); font-weight: 800; }
