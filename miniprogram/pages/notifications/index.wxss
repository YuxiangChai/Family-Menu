.subscription { padding: 28rpx; margin-bottom: 24rpx; }
.subscription-title { font-size: 30rpx; font-weight: 700; }
.subscription-description { margin: 12rpx 0 20rpx; color: var(--muted); font-size: 26rpx; line-height: 1.7; }
.subscription-state { margin-bottom: 20rpx; color: var(--leaf); font-size: 24rpx; }
.stop-reminders { min-height: 88rpx; margin-top: 8rpx; color: var(--muted); font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.section-heading { margin: 24rpx 8rpx 16rpx; display: flex; justify-content: space-between; color: var(--muted); font-size: 24rpx; }
.message-card { width: 100%; margin: 0 0 16rpx; padding: 24rpx; text-align: left; color: var(--ink); }
.message-top { display: flex; justify-content: space-between; gap: 16rpx; font-size: 28rpx; font-weight: 700; }
.message-top > text { flex: none; color: var(--muted); font-size: 23rpx; font-weight: 400; }
.unread-dot { display: inline-block; width: 12rpx; height: 12rpx; margin-left: 12rpx; border-radius: 50%; background: var(--brand); }
.message-items { margin: 16rpx 0; font-size: 27rpx; line-height: 1.7; }
.message-bottom { display: flex; justify-content: space-between; gap: 16rpx; color: var(--muted); font-size: 23rpx; }
