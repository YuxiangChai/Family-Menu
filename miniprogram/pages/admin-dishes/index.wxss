.heading { margin: 4rpx 6rpx 26rpx 18rpx; }
.title { margin: 3rpx 0 5rpx; font-size: 44rpx; }
.heading .muted { font-size: 22rpx; }
.dish-list { display: grid; gap: 12rpx; }
.dish-row { min-height: 124rpx; padding: 13rpx 18rpx 13rpx 13rpx; display: flex; align-items: center; gap: 15rpx; }
.disabled-row { opacity: .56; filter: grayscale(.25); }
.thumb { width: 96rpx; height: 96rpx; flex: none; border-radius: 12rpx; }
.thumb-placeholder { display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #d9aa8e, #efd8c4); color: var(--brand-dark); font-size: 32rpx; font-weight: 800; }
.dish-main { flex: 1; min-width: 0; padding: 4rpx 0; }
.name { font-size: 28rpx; font-weight: 800; }
.meta, .enabled-text { color: var(--muted); font-size: 20rpx; }
.enabled-text { margin-top: 2rpx; color: var(--leaf); }
.toggle { width: 92rpx; height: 50rpx; flex: none; border: 1rpx solid transparent; border-radius: 25rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; font-size: 21rpx; font-weight: 700; line-height: 1; transition: opacity .16s ease, transform .16s ease; }
.toggle-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; opacity: .72; }
.toggle.off { border-color: #efd0c8; background: #faebe6; color: var(--danger); }
.toggle.on { border-color: #c9ddc6; background: #e7f0e4; color: #3f6339; }
.toggle-pressed { opacity: .68; transform: scale(.96); }
