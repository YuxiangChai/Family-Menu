.orders-page { padding-top: 32rpx; }
.order-list { display: grid; gap: 14rpx; }
.order-card { padding: 24rpx; border-left: 5rpx solid var(--gold); transition: opacity .16s ease, transform .16s ease; }
.order-pressed { opacity: .74; }
.order-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.order-date-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx 16rpx; margin-bottom: 12rpx; }
.order-date { color: var(--ink); font-size: 42rpx; font-weight: 800; line-height: 1.3; }
.order-weekday { flex: none; padding: 4rpx 12rpx; border-radius: 8rpx; color: var(--brand-dark); background: var(--brand-soft); font-size: 26rpx; font-weight: 700; line-height: 1.5; white-space: nowrap; }
.creator { color: var(--ink); font-size: 34rpx; font-weight: 800; line-height: 1.4; }
.time { margin-top: 4rpx; color: var(--muted); font-size: 24rpx; }
.order-heading { min-width: 0; }
.creator { overflow-wrap: anywhere; }
.order-items { margin: 18rpx 0; color: var(--ink); font-size: 24rpx; line-height: 1.65; }
.preview-dish { display: flex; align-items: center; gap: 12rpx; }
.preview-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.preview-servings { flex: none; color: var(--muted); }
.more-dishes { margin-top: 6rpx; color: var(--muted); font-size: 22rpx; }
.order-bottom { padding-top: 15rpx; border-top: 1rpx solid var(--line); display: flex; justify-content: space-between; color: var(--muted); font-size: 21rpx; }
.order-bottom { align-items: center; gap: 12rpx; }
.notification-link { margin: 0 0 20rpx; padding: 16rpx 20rpx; min-height: 88rpx; display: flex; align-items: center; gap: 12rpx; background: var(--paper-deep); color: var(--ink); font-size: 25rpx; text-align: left; }
.notification-link > text:last-child { margin-left: auto; color: var(--muted); font-size: 22rpx; }
.unread-badge { padding: 2rpx 12rpx; border-radius: 20rpx; background: var(--brand); color: #fff; }
.order-bottom .order-button { margin: 0; flex: 1; min-width: 0; max-width: none; font-size: 26rpx; }
.poster-canvas { position: fixed; left: -2000px; top: 0; width: 600px; height: 600px; pointer-events: none; }
.load-more { margin-top: 20rpx; }
.load-error { padding: 20rpx; color: var(--danger); }
