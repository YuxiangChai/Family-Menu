<view class="page orders-page">
  <view class="page-header"><text class="page-header-kicker">{{isAdmin ? '今日灶台' : '我的点菜'}}</text><view class="page-header-title">今晚订单</view><view class="page-header-meta">{{today}}{{isAdmin ? ' · 全部家庭订单' : ''}}</view></view>
  <view wx:if="{{loading}}" class="state-panel card"><view class="state-mark">···</view><view class="state-title">正在查看订单</view></view>
  <view wx:elif="{{error}}" class="state-panel card"><view class="state-mark">!</view><view class="state-title">订单没加载出来</view><view class="state-text">{{error}}</view><button class="secondary-button" bindtap="loadOrders">重试</button></view>
  <view wx:elif="{{!orders.length}}" class="state-panel card"><view class="state-mark">0</view><view class="state-title">还没有点菜</view><view class="state-text">从菜单挑几道菜，提交后会出现在这里。</view></view>
  <view wx:else class="order-list">
    <view wx:for="{{orders}}" wx:key="_id" class="order-card card" data-id="{{item._id}}" bindtap="openOrder" hover-class="order-pressed">
      <view class="order-top"><view><view class="creator">{{item.creatorName || '家人'}} 的菜单</view><view class="time">{{item.timeText}}</view></view><text class="status-chip {{item.statusClass}}">{{item.statusText}}</text></view>
      <view class="order-items">{{item.itemText}}</view>
      <view class="order-bottom"><text>{{item.dinerCount}} 人用餐</text><text>查看清单 ›</text></view>
    </view>
  </view>
</view>
