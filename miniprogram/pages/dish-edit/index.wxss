.edit-page { padding-top: 16rpx; }
.form-section { margin-bottom: 18rpx; padding: 24rpx; }
.section-title { font-size: 32rpx; }
.section-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 14rpx; }
.helper { margin-top: 2rpx; font-size: 20rpx; }
.image-picker { width: 100%; height: 270rpx; border-radius: 14rpx; overflow: hidden; background: var(--paper-deep); border: 1rpx dashed #cfbdab; }
.image-picker image { width: 100%; height: 100%; }
.image-empty { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7rpx; color: var(--brand-dark); font-size: 23rpx; }
.plus { font-size: 44rpx; }
.field-picker { display: flex; align-items: center; justify-content: space-between; }
.two-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.switch-row { min-height: 88rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); display: flex; align-items: center; justify-content: space-between; }
.switch-title { font-weight: 700; }
.switch-desc { font-size: 20rpx; }
.mini-add { width: 146rpx; height: 52rpx; flex: none; padding: 0 13rpx 0 8rpx; border: 1rpx solid #efd2ca; border-radius: 26rpx; display: flex; align-items: center; justify-content: center; gap: 7rpx; background: #fae8e2; color: var(--brand-dark); font-size: 19rpx; font-weight: 700; line-height: 1; }
.mini-add-icon { width: 32rpx; height: 32rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; background: var(--brand); color: #fff; font-size: 20rpx; }
.control-pressed { opacity: .68; transform: scale(.97); }
.ingredient-editor { margin-top: 16rpx; padding: 16rpx; border: 1rpx solid rgba(81,67,52,.12); border-radius: 18rpx; background: #fffdf9; box-shadow: 0 6rpx 18rpx rgba(71,54,37,.035); }
.editor-top { min-height: 48rpx; margin-bottom: 14rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.ingredient-title { display: flex; align-items: center; gap: 9rpx; color: var(--ink); font-size: 23rpx; font-weight: 700; white-space: nowrap; }
.ingredient-number { color: var(--brand); font-size: 17rpx; font-weight: 800; letter-spacing: 1rpx; }
.ingredient-actions { display: flex; align-items: center; gap: 9rpx; }
.type-toggle { width: 162rpx; height: 46rpx; padding: 3rpx; border-radius: 23rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 3rpx; background: #eee8df; }
.type-option { height: 40rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 18rpx; font-weight: 700; line-height: 1; }
.type-option.selected { color: #fff; box-shadow: 0 3rpx 8rpx rgba(45,49,42,.12); }
.type-option.selected.main { background: var(--leaf); }
.type-option.selected.seasoning { background: var(--brand); }
.remove-ingredient, .step-remove { width: 42rpx; height: 42rpx; flex: none; border-radius: 21rpx; display: flex; align-items: center; justify-content: center; background: #fae7e2; color: var(--danger); font-size: 27rpx; line-height: 1; }
.remove-ingredient.disabled, .step-remove.disabled { opacity: .28; }
.ingredient-fields { display: grid; gap: 10rpx; }
.ingredient-editor .field-input { height: 76rpx; min-height: 76rpx; margin: 0; padding: 0 18rpx; border-radius: 12rpx; background: #fff; font-size: 25rpx; line-height: 74rpx; }
.quantity-row { display: grid; grid-template-columns: 1.45fr 1fr; gap: 10rpx; }
.ingredient-note { background: #fbf7f1 !important; }
.step-editor { margin-top: 16rpx; display: flex; align-items: flex-start; gap: 9rpx; }
.step-index { width: 44rpx; height: 44rpx; flex: none; border-radius: 9rpx; display: flex; align-items: center; justify-content: center; background: var(--brand); color: #fff; font-size: 20rpx; font-weight: 700; }
.step-editor textarea { flex: 1; height: 112rpx; min-height: 112rpx; max-height: 112rpx; padding: 14rpx 16rpx; border: 1rpx solid var(--line); border-radius: 12rpx; background: #fff; font-size: 24rpx; line-height: 1.5; }
.step-remove { margin-top: 1rpx; }
.form-error { margin: 0 0 18rpx; padding: 17rpx 20rpx; border-radius: 12rpx; background: #fae5df; color: var(--danger); font-size: 23rpx; }
